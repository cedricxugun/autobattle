; Native desktop presentation. The simulation service runs only on loopback.
config_version=5

[application]
config/name="万象棋局"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/size/resizable=true

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.065, 0.085, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
driver/enable_input=false
